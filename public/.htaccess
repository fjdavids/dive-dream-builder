AddDefaultCharset UTF-8

# Dive Life — canonical host + SPA fallback (Hostinger / Apache)

RewriteEngine On

# 301: single canonical version is https://divelife.mx/
# Redirects http://divelife.mx, http://www.divelife.mx and https://www.divelife.mx
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.divelife\.mx$ [NC]
RewriteRule ^ https://divelife.mx%{REQUEST_URI} [R=301,L]

# SPA fallback: serve real files/directories, everything else goes to index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
RewriteRule ^ /index.html [L]

# ---- Caching (hashed /assets/* get 1 year via assets/.htaccess) ----
<IfModule mod_headers.c>
  # HTML (incl. prerendered index.html) and crawl/deploy files: always revalidate
  <FilesMatch "\.(html?|xml|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Un-hashed files in the site root (favicons, logo): one week
  <FilesMatch "\.(png|ico|svg|webp|jpg|jpeg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# ---- Compression (only if the server module is available) ----
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript text/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/json application/xml image/svg+xml
</IfModule>
